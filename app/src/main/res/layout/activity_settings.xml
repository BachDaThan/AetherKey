<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aether_background_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/aether_secondary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Keys (mỗi key 1 dòng - BYOK)"
            android:textColor="@color/aether_text"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_api_keys"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:background="@color/aether_key_bg"
            android:textColor="@color/aether_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Base URL (OpenAI-compatible)"
            android:textColor="@color/aether_text"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:background="@color/aether_key_bg"
            android:textColor="@color/aether_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model Name"
            android:textColor="@color/aether_text"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:background="@color/aether_key_bg"
            android:textColor="@color/aether_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngôn ngữ mục tiêu (en, vi, ja...)"
            android:textColor="@color/aether_text"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_target_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:background="@color/aether_key_bg"
            android:textColor="@color/aether_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu cấu hình"
            android:backgroundTint="@color/aether_primary"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
